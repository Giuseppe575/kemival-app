{
  "name": "movarisch",
  "version": "1.6.0",
  "private": true,
  "scripts": {
    "vendor:pdf": "esbuild src/lib/pdf-loader.js --bundle --format=iife --platform=browser --target=chrome120 --minify --define:process=undefined --log-override:empty-import-meta=silent --outfile=src/lib/pdf.bundle.js",
    "test": "node --test __tests__/**/*.test.js",
    "vendor:excel": "esbuild src/lib/excel-loader.js --bundle --format=iife --platform=browser --target=chrome120 --minify --outfile=src/lib/excel.bundle.js",
    "notices": "node scripts/generate-notices.js",
    "sbom": "node scripts/generate-sbom.js",
    "prepare:store": "npm run vendor:excel && npm run notices && npm run sbom"
  },
  "dependencies": {
    "chart.js": "4.4.1",
    "docx": "8.5.0",
    "pdfjs-dist": "4.10.38",
    "write-excel-file": "4.1.1"
  },
  "devDependencies": {
    "esbuild": "0.25.8"
  }
}
