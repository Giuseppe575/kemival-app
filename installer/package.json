{
  "name": "movarisch",
  "version": "1.6.0",
  "description": "KEMIVAL — valutazione del rischio chimico, distribuzione e licenze Microsoft Store",
  "main": "main.js",
  "author": {
    "name": "Dott. Giuseppe Strifezza",
    "email": "atis.giuseppe@gmail.com"
  },
  "homepage": "https://giuseppe575.github.io/kemival/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Giuseppe575/kemival-app.git"
  },
  "license": "SEE LICENSE IN ../docs/eula.html",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "verify:config": "node scripts/verify-release.js",
    "build:bridge": "node scripts/build-store-bridge.js",
    "store:assets": "node scripts/generate-store-assets.js",
    "build": "npm run build:store",
    "build:dir": "npm run build:bridge && electron-builder --config electron-builder.store.cjs --win --x64 --dir --publish never",
    "build:store:test": "npm run build:bridge && npm run store:assets && electron-builder --config electron-builder.store.cjs --win appx --x64 --publish never",
    "build:store": "npm --prefix .. run prepare:store && npm run verify:config && npm run build:bridge && npm run store:assets && node scripts/build-store.js",
    "release:build": "npm run build:store && node scripts/verify-release.js --artifacts",
    "sbom": "npm sbom --sbom-format=cyclonedx --package-lock-only",
    "test:runtime": "electron scripts/smoke-electron.js"
  },
  "devDependencies": {
    "@electron/fuses": "2.1.3",
    "electron": "43.8.6",
    "electron-builder": "26.18.0",
    "png-to-ico": "^3.0.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "com.giuseppe.movarisch",
    "productName": "KEMIVAL",
    "copyright": "Copyright © 2026 Dott. Giuseppe Strifezza",
    "directories": {
      "output": "dist-store",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "index.html",
          "app.js",
          "style.css",
          "cumulative-report.html",
          "src/**/*",
          "support/**/*",
          "docs/privacy.html",
          "docs/termini.html",
          "docs/eula.html",
          "docs/css/**/*",
          "THIRD_PARTY_NOTICES.txt",
          "sbom/*.json"
        ]
      },
      {
        "from": "store-bridge/bin",
        "to": "store-bridge",
        "filter": [
          "Kemival.StoreLicense.exe"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true,
      "requestedExecutionLevel": "asInvoker"
    },
    "compression": "maximum",
    "asar": true,
    "publish": null,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true
    }
  }
}
