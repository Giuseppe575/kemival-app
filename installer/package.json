{
  "name": "movarisch",
  "version": "1.5.1",
  "description": "KEMIVAL - Software professionale per l'analisi automatizzata del rischio chimico secondo il modello MoVaRisCh",
  "main": "main.js",
  "author": {
    "name": "Dott. Giuseppe Strifezza",
    "email": "atis.giuseppe@gmail.com"
  },
  "homepage": "https://giuseppe575.github.io/kemival/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Giuseppe575/kemival-app.git"
  },
  "license": "SEE LICENSE IN ../docs/eula.html",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/**/*.test.js",
    "verify:config": "node scripts/verify-release.js",
    "build": "npm run verify:config && electron-builder --win --x64 --publish never",
    "build:dir": "npm run verify:config && electron-builder --win --x64 --dir --publish never",
    "store:assets": "node scripts/generate-store-assets.js",
    "build:store:test": "npm run store:assets && electron-builder --config electron-builder.store.cjs --win appx --x64 --publish never",
    "build:store": "npm run store:assets && node scripts/build-store.js",
    "release:build": "node scripts/verify-release.js --release && electron-builder --win --x64 --publish never -c.win.forceCodeSigning=true && node scripts/verify-release.js --release --artifacts --signature",
    "dist": "npm run build"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.giuseppe.movarisch",
    "productName": "KEMIVAL",
    "copyright": "Copyright © 2026 Dott. Giuseppe Strifezza",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "lib/**/*",
      "../index.html",
      "../app.js",
      "../style.css",
      "../cumulative-report.html",
      "../src/**/*",
      "../support/**/*",
      "../docs/**/*",
      "!../docs/acquista.html",
      "!../docs/index.html",
      "!../docs/grazie.html",
      "!../installer/**/*",
      "!../node_modules/**/*",
      "!../backup*/**/*",
      "!../test-*.html",
      "!../*.pdf",
      "!../*.zip",
      "!../generate-excel-template.js"
    ],
    "extraResources": [
      {
        "from": "../",
        "to": "app",
        "filter": [
          "index.html",
          "app.js",
          "style.css",
          "cumulative-report.html",
          "src/**/*",
          "support/**/*",
          "docs/privacy.html",
          "docs/termini.html",
          "docs/eula.html",
          "docs/css/**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "verifyUpdateCodeSignature": true,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KEMIVAL",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "language": "1040",
      "artifactName": "KEMIVAL-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false,
      "perMachine": false,
      "runAfterFinish": true,
      "license": "../docs/eula.html",
      "installerLanguages": [
        "it_IT"
      ],
      "include": "build/installer.nsh"
    },
    "compression": "maximum",
    "asar": true,
    "publish": {
      "provider": "github",
      "owner": "Giuseppe575",
      "repo": "kemival-app",
      "releaseType": "release"
    }
  }
}
